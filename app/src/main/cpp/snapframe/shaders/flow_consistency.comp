#version 450

// Forward/backward cycle validation for the two coarse block-matching fields.
// Motion vectors are measured in half-resolution luma texels. The luma
// reference input provides the active flow-grid stride for projection.
// R16F output is a soft validity/confidence mask.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(push_constant) uniform PC { uint flowWidth; uint flowHeight; } pc;
layout(set = 0, binding = 0) uniform sampler2D flowCurrentToPrevious;
layout(set = 0, binding = 1) uniform sampler2D flowPreviousToCurrent;
layout(set = 0, binding = 2, r16f) writeonly uniform image2D consistencyOutput;
layout(set = 0, binding = 3) uniform sampler2D currentLuma;
layout(set = 0, binding = 4) uniform sampler2D previousLuma;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = ivec2(pc.flowWidth, pc.flowHeight);
    if (any(greaterThanEqual(p, extent)))
        return;

    vec4 forwardFlow = texelFetch(flowCurrentToPrevious, p, 0);
    ivec2 lumaExtent = textureSize(currentLuma, 0);
    ivec2 blockStride = max(ivec2(1), ivec2(ceil(vec2(lumaExtent) / vec2(extent))));
    ivec2 blockCenter = min(p * blockStride + blockStride / 2, lumaExtent - ivec2(2));
    vec2 lumaPosition = vec2(blockCenter) + forwardFlow.xy;
    // Flow cells represent block centers (p * stride + stride/2), not
    // block corners. Project to the nearest reverse cell center; floor(pos/stride)
    // biases the lookup by roughly half a cell and can invalidate good matches.
    vec2 reverseCell = (lumaPosition - 0.5 * vec2(blockStride)) / vec2(blockStride);
    ivec2 reverseCoord = ivec2(round(reverseCell));
    ivec2 reverseExtent = textureSize(flowPreviousToCurrent, 0);

    if (any(lessThan(reverseCoord, ivec2(0))) ||
        any(greaterThanEqual(reverseCoord, reverseExtent))) {
        imageStore(consistencyOutput, p, vec4(0.0));
        return;
    }

    vec4 reverseFlow = texelFetch(flowPreviousToCurrent, reverseCoord, 0);
    float fbError = length(forwardFlow.xy + reverseFlow.xy);
    float threshold = 0.75 + 0.05 * length(forwardFlow.xy);
    float consistency = 1.0 - smoothstep(threshold, threshold * 2.0, fbError);
    float localConfidence = min(forwardFlow.z, reverseFlow.z);

    // Explicit soft visibility estimate: a geometrically inconsistent match is
    // rejected by FB validation above; a photometrically inconsistent projection
    // is additionally down-weighted as likely disocclusion/occlusion or mismatch.
    // Luma values are normalized by the downsample pass, so thresholds are
    // resolution-independent and deliberately conservative.
    ivec2 previousExtent = textureSize(previousLuma, 0);
    ivec2 currentExtent = textureSize(currentLuma, 0);
    ivec2 sourceCoord = clamp(blockCenter, ivec2(0), previousExtent - ivec2(1));
    ivec2 targetCoord = clamp(ivec2(round(lumaPosition)), ivec2(0), currentExtent - ivec2(1));
    float sourceY = texelFetch(previousLuma, sourceCoord, 0).r;
    float targetY = texelFetch(currentLuma, targetCoord, 0).r;
    float photometricError = abs(sourceY - targetY);
    float photometricVisibility = 1.0 - smoothstep(0.08, 0.28, photometricError);
    float visibility = clamp(localConfidence * 2.0, 0.0, 1.0) *
                       photometricVisibility;
    consistency *= visibility;
    imageStore(consistencyOutput, p, vec4(consistency, 0.0, 0.0, 1.0));
}

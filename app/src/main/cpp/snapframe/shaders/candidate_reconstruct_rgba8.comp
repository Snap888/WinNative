#version 450

// RGBA8 output variant; all scoring and candidate metadata remain FP16.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(push_constant) uniform PC {
    uint flowWidth;
    uint flowHeight;
    uint fullWidth;
    uint fullHeight;
} pc;
layout(set = 0, binding = 0) uniform sampler2D previousColor;
layout(set = 0, binding = 1) uniform sampler2D currentColor;
layout(set = 0, binding = 2) uniform sampler2D candidate0;
layout(set = 0, binding = 3) uniform sampler2D candidate1;
layout(set = 0, binding = 4) uniform sampler2D candidate2;
layout(set = 0, binding = 5) uniform sampler2D candidate3;
layout(set = 0, binding = 6) uniform sampler2D candidateWeights;
layout(set = 0, binding = 7, rgba8) writeonly uniform image2D generatedFrame;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 fullExtent = imageSize(generatedFrame);
    if (any(greaterThanEqual(p, fullExtent))) return;

    vec2 uv = (vec2(p) + vec2(0.5)) / vec2(fullExtent);
    ivec2 flowExtent = ivec2(pc.flowWidth, pc.flowHeight);
    ivec2 cell = clamp(ivec2(uv * vec2(flowExtent)),
                       ivec2(0), flowExtent - ivec2(1));
    vec4 a = texelFetch(candidate0, cell, 0);
    vec4 b = texelFetch(candidate1, cell, 0);
    vec4 c = texelFetch(candidate2, cell, 0);
    vec4 d = texelFetch(candidate3, cell, 0);
    vec4 w = max(texelFetch(candidateWeights, cell, 0), vec4(0.0));
    float sumWeights = dot(w, vec4(1.0));

    vec4 result;
    if (sumWeights > 1.0e-4) {
        vec4 ca = texture(previousColor, a.xy);
        vec4 cb = texture(currentColor, b.xy);
        vec4 cc = texture(previousColor, c.xy);
        vec4 cd = texture(currentColor, d.xy);
        result = (ca * w.x + cb * w.y + cc * w.z + cd * w.w) / sumWeights;
    } else {
        result = texture(currentColor, uv);
    }
    imageStore(generatedFrame, p, result);
}

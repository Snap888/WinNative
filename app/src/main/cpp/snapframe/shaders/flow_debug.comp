#version 450

// Diagnostic flow visualization. Hue represents vector direction, brightness
// represents displacement magnitude, and dark pixels identify inconsistent/
// occluded motion. This is a GPU-only view of SnapFrame's own flow field.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(push_constant) uniform PC { uint width; uint height; uint flowWidth; uint flowHeight; float magnitudeScale; uint debugMode; } pc;
layout(set = 0, binding = 0) uniform sampler2D motionField;
layout(set = 0, binding = 1) uniform sampler2D consistencyField;
layout(set = 0, binding = 2, rgba8) writeonly uniform image2D debugOutput;

vec3 hsvToRgb(vec3 c) {
    vec3 p = abs(fract(c.xxx + vec3(0.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(pc.width, pc.height);
    if (any(greaterThanEqual(p, size))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(size);
    ivec2 flowSize = ivec2(pc.flowWidth, pc.flowHeight);
    ivec2 flowPos = clamp(ivec2(uv * vec2(flowSize)), ivec2(0), flowSize - ivec2(1));
    vec4 flow = texelFetch(motionField, flowPos, 0);
    float consistency = clamp(texelFetch(consistencyField, flowPos, 0).r, 0.0, 1.0);
    vec3 color;
    if (pc.debugMode == 1u) {
        // flow.z is the block matcher's best/second-best SAD confidence.
        float confidence = clamp(flow.z, 0.0, 1.0);
        color = vec3(1.0 - confidence, 0.12 + 0.78 * confidence, 0.08);
    } else if (pc.debugMode == 2u) {
        // The consistency mask includes forward/backward error and local matcher confidence.
        color = vec3(1.0 - consistency, consistency, 0.08 + 0.12 * consistency);
    } else {
        float angle = atan(flow.y, flow.x) / 6.28318530718 + 0.5;
        float magnitude = clamp(length(flow.xy) * pc.magnitudeScale, 0.08, 1.0);
        color = hsvToRgb(vec3(fract(angle), 0.92, magnitude));
        color *= mix(0.12, 1.0, smoothstep(0.08, 0.55, consistency));
        if (consistency < 0.08) color = vec3(0.035, 0.025, 0.04);
    }
    imageStore(debugOutput, p, vec4(color, 1.0));
}
